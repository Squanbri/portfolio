---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ScreenshotSlider from '../../components/ScreenshotSlider.astro';
import ArchitectureDiagram from '../../components/ArchitectureDiagram.astro';
import { projects, getProject } from '../../data/content';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
  }));
}

const { slug } = Astro.params;
const project = getProject(slug!);

if (!project) {
  return Astro.redirect('/');
}

const hasFeatures = Boolean(project.features?.length);
const hasDecisions = Boolean(project.decisions?.length);
const hasDiagram = Boolean(project.architecture?.diagram);
const hasNodeFlow = Boolean(project.architecture?.nodes?.length);
const hasRichArchitecture = hasDiagram || hasNodeFlow;
const primaryLink = project.links[0];
const showCta = Boolean(project.cta && primaryLink);
const aboutParagraphs = project.paragraphs?.length
  ? project.paragraphs
  : [project.description];

let step = 1;
const steps = {
  about: String(step++).padStart(2, '0'),
  screens: String(step++).padStart(2, '0'),
  features: hasFeatures ? String(step++).padStart(2, '0') : null,
  decisions: hasDecisions ? String(step++).padStart(2, '0') : null,
  architecture: String(step++).padStart(2, '0'),
  stack: String(step++).padStart(2, '0'),
};
---

<BaseLayout title={`${project.title} — Евгений Маркитан`} description={project.summary}>
  <article class="project-page">
    <div class="container">
      <a class="back" href="/#projects">← К портфолио</a>

      <header class="hero">
        {project.eyebrow && <p class="eyebrow">{project.eyebrow}</p>}
        <h1>{project.title}</h1>
        <p class="summary">{project.summary}</p>

        {
          project.links.length > 0 && (
            <div class="hero-actions">
              {project.links.map((link, index) => (
                <a
                  class:list={['btn', index === 0 ? 'btn-primary' : 'btn-ghost']}
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {link.label}
                  <span aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          )
        }
      </header>

      <section class="block" aria-labelledby="about-title">
        <div class="section-title">
          <p class="step">{steps.about}</p>
          <h2 id="about-title">О проекте</h2>
        </div>
        <div class="prose-block">
          {aboutParagraphs.map((paragraph) => (
            <p class="prose">{paragraph}</p>
          ))}
        </div>
      </section>

      <section class="screens block" aria-labelledby="screens-title">
        <div class="section-title">
          <p class="step">{steps.screens}</p>
          <h2 id="screens-title">Интерфейс</h2>
        </div>
        <ScreenshotSlider images={project.screenshots} id={`project-${project.slug}`} />
      </section>

      {
        hasFeatures && (
          <section class="block" aria-labelledby="features-title">
            <div class="section-title">
              <p class="step">{steps.features}</p>
              <h2 id="features-title">Что умеет</h2>
            </div>

            <ul class="features">
              {project.features!.map((feature) => (
                <li class="feature">
                  <h3>{feature.title}</h3>
                  <p>{feature.text}</p>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        hasDecisions && (
          <section class="block" aria-labelledby="decisions-title">
            <div class="section-title">
              <p class="step">{steps.decisions}</p>
              <h2 id="decisions-title">Ключевые решения</h2>
            </div>

            <ul class="decisions">
              {project.decisions!.map((item) => (
                <li class="decision">
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <section class="block" aria-labelledby="architecture-title">
        <div class="section-title">
          <p class="step">{steps.architecture}</p>
          <h2 id="architecture-title">Архитектура</h2>
        </div>

        {
          hasRichArchitecture ? (
            <div class="architecture">
              {project.architecture?.diagram === 'letter-box' ? (
                <ArchitectureDiagram title={`Схема архитектуры ${project.title}`} />
              ) : (
                <div
                  class="architecture-flow"
                  aria-label={`Схема архитектуры ${project.title}`}
                >
                  {project.architecture!.nodes!.map((node, index) => (
                    <>
                      {index > 0 && (
                        <span class="arch-arrow" aria-hidden="true">
                          →
                        </span>
                      )}
                      <div class="arch-node">
                        <span>{node.label}</span>
                        <strong>{node.title}</strong>
                      </div>
                    </>
                  ))}
                </div>
              )}

              {
                project.architecture?.targets &&
                  project.architecture.targets.length > 0 && (
                    <div class="architecture-targets">
                      {project.architecture.targets.map((target) => (
                        <span>{target}</span>
                      ))}
                    </div>
                  )
              }

              <p class="architecture-note">{project.architectureNote}</p>
            </div>
          ) : (
            <>
              <p class="prose">{project.architectureNote}</p>
              <div class="architecture-flow simple-arch" aria-hidden="true">
                <div class="arch-node">
                  <strong>Client</strong>
                </div>
                <span class="arch-arrow">→</span>
                <div class="arch-node">
                  <strong>API</strong>
                </div>
                <span class="arch-arrow">→</span>
                <div class="arch-node">
                  <strong>DB</strong>
                </div>
              </div>
            </>
          )
        }
      </section>

      <section class="stack block" aria-labelledby="stack-title">
        <div class="section-title">
          <p class="step">{steps.stack}</p>
          <h2 id="stack-title">Технологии</h2>
        </div>
        <ul class="tag-list">
          {project.stack.map((item) => (
            <li>
              <span class="tag">{item}</span>
            </li>
          ))}
        </ul>
      </section>

      {
        showCta && (
          <footer class="project-cta">
            <div>
              <p class="eyebrow">{project.cta!.eyebrow}</p>
              <h2>{project.cta!.title}</h2>
            </div>
            <a
              class="btn btn-primary"
              href={primaryLink.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              {project.cta!.label} <span aria-hidden="true">↗</span>
            </a>
          </footer>
        )
      }
    </div>
  </article>
</BaseLayout>

<style>
  .project-page {
    padding-block: clamp(2rem, 6vw, 4rem);
  }

  .back {
    display: inline-flex;
    margin-bottom: clamp(1.75rem, 4vw, 3rem);
    color: var(--text-muted);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
  }

  .back:hover {
    color: var(--accent);
  }

  .hero {
    max-width: 44rem;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .eyebrow,
  .step {
    margin: 0;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0.4rem 0 0.85rem;
    font-size: clamp(2.25rem, 5vw, 3.4rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
  }

  .summary {
    max-width: 40rem;
    margin: 0;
    color: var(--text-muted);
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    line-height: 1.5;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.5rem;
  }

  .block {
    margin-bottom: clamp(2.75rem, 7vw, 4.5rem);
  }

  .section-title {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 1.15rem;
  }

  .section-title h2,
  .project-cta h2 {
    margin: 0;
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    letter-spacing: -0.03em;
  }

  .prose-block {
    display: grid;
    gap: 0.9rem;
    max-width: 44rem;
  }

  .prose {
    max-width: 44rem;
    margin: 0;
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .screens :global(.viewport) {
    box-shadow: var(--shadow);
  }

  .features,
  .decisions {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    border-top: 1px solid var(--border);
  }

  .feature,
  .decision {
    padding: 1.15rem 1.25rem 1.15rem 0;
    border-bottom: 1px solid var(--border);
  }

  .feature:nth-child(even),
  .decision:nth-child(even) {
    padding-left: 1.25rem;
    padding-right: 0;
  }

  .feature h3,
  .decision h3 {
    margin: 0 0 0.3rem;
    font-size: 1.05rem;
  }

  .feature p,
  .decision p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .architecture {
    padding: clamp(1rem, 3vw, 1.5rem) 0;
  }

  .architecture-flow,
  .simple-arch {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    gap: 0.55rem 0.65rem;
  }

  .arch-node {
    padding: 0.7rem 0.9rem;
    border: 1px dashed var(--border);
    border-radius: 6px;
    background: transparent;
    text-align: left;
  }

  .arch-node span {
    display: block;
    margin-bottom: 0.15rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
  }

  .arch-node strong {
    font-size: 0.9rem;
    font-weight: 650;
  }

  .arch-arrow {
    flex: 0 0 auto;
    color: var(--accent);
    font-family: var(--font-mono);
  }

  .architecture-targets {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1rem;
  }

  .architecture-targets span {
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .architecture-note {
    max-width: 40rem;
    margin: 1.25rem 0 0;
    color: var(--text-muted);
  }

  .simple-arch {
    margin-top: 1rem;
  }

  .stack .tag-list {
    gap: 0.5rem;
  }

  .stack .tag {
    padding: 0.4rem 0.65rem;
    color: var(--text);
  }

  .project-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .project-cta h2 {
    margin-top: 0.25rem;
  }

  @media (max-width: 720px) {
    .features,
    .decisions {
      grid-template-columns: 1fr;
    }

    .feature,
    .feature:nth-child(even),
    .decision,
    .decision:nth-child(even) {
      padding-left: 0;
      padding-right: 0;
    }

    .architecture-flow {
      flex-direction: column;
      align-items: stretch;
    }

    .arch-arrow {
      transform: rotate(90deg);
      align-self: center;
    }

    .project-cta {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
