---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ScreenshotSlider from '../../components/ScreenshotSlider.astro';
import { projects, getProject } from '../../data/content';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
  }));
}

const { slug } = Astro.params;
const project = getProject(slug!);

if (!project) {
  return Astro.redirect('/');
}

const isLetterBox = project.slug === 'letter-box';
const features = [
  {
    icon: '▦',
    title: 'Несколько аккаунтов',
    text: 'Mail.ru, Яндекс и Gmail в одном приложении.',
  },
  {
    icon: '↻',
    title: 'Фоновая синхронизация',
    text: 'Почта обновляется независимо от desktop-клиента.',
  },
  {
    icon: '→',
    title: 'IMAP и SMTP',
    text: 'Получение, отправка, ответы и пересылка писем.',
  },
  {
    icon: '✦',
    title: 'Локальный AI',
    text: 'Ollama размечает письма без внешних AI API.',
  },
];
---

<BaseLayout title={`${project.title} — Евгений Маркитан`} description={project.summary}>
  <article class:list={['project-page', { 'letter-box': isLetterBox }]}>
    <div class="container">
      <a class="back" href="/#projects">← К портфолио</a>

      <header class="hero">
        {isLetterBox && <p class="eyebrow">Personal project · Full-stack · macOS</p>}
        <h1>{project.title}</h1>
        <p class="summary">{project.summary}</p>

        <div class="hero-actions">
          {
            project.links.map((link) => (
              <a
                class:list={['btn', isLetterBox ? 'btn-primary' : 'btn-ghost']}
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                {link.label}
                <span aria-hidden="true">↗</span>
              </a>
            ))
          }
        </div>
      </header>

      <section class="screens block" aria-labelledby="screens-title">
        <div class="section-title">
          <p class="step">01</p>
          <h2 id="screens-title">Интерфейс</h2>
        </div>
        <ScreenshotSlider images={project.screenshots} id={`project-${project.slug}`} />
      </section>

      {
        isLetterBox && (
          <section class="block" aria-labelledby="features-title">
            <div class="section-title">
              <p class="step">02</p>
              <h2 id="features-title">Что умеет</h2>
            </div>

            <div class="features">
              {features.map((feature) => (
                <article class="feature">
                  <span class="feature-icon" aria-hidden="true">{feature.icon}</span>
                  <h3>{feature.title}</h3>
                  <p>{feature.text}</p>
                </article>
              ))}
            </div>
          </section>
        )
      }

      <section class="block" aria-labelledby="architecture-title">
        <div class="section-title">
          <p class="step">{isLetterBox ? '03' : '02'}</p>
          <h2 id="architecture-title">Архитектура</h2>
        </div>

        {isLetterBox ? (
          <div class="architecture-card">
            <div class="architecture-flow" aria-label="Схема архитектуры Letter Box">
              <div class="arch-node arch-client">
                <span>Desktop</span>
                <strong>Electron + React</strong>
              </div>

              <span class="arch-arrow" aria-hidden="true">→</span>

              <div class="arch-node arch-api">
                <span>Backend</span>
                <strong>NestJS API</strong>
              </div>

              <span class="arch-arrow" aria-hidden="true">→</span>

              <div class="arch-node arch-queue">
                <span>Queue</span>
                <strong>Redis + BullMQ</strong>
              </div>

              <span class="arch-arrow" aria-hidden="true">→</span>

              <div class="arch-node arch-worker">
                <span>Processing</span>
                <strong>Sync / AI Worker</strong>
              </div>
            </div>

            <div class="architecture-targets">
              <span>PostgreSQL</span>
              <span>IMAP / SMTP</span>
              <span>Ollama</span>
            </div>

            <p class="architecture-note">{project.architectureNote}</p>
          </div>
        ) : (
          <>
            <p class="architecture-note">{project.architectureNote}</p>
            <div class="simple-arch" aria-hidden="true">
              <div class="arch-node"><strong>Client</strong></div>
              <span class="arch-arrow">→</span>
              <div class="arch-node"><strong>API</strong></div>
              <span class="arch-arrow">→</span>
              <div class="arch-node"><strong>DB</strong></div>
            </div>
          </>
        )}
      </section>

      <section class="stack block" aria-labelledby="stack-title">
        <div class="section-title">
          <p class="step">{isLetterBox ? '04' : '03'}</p>
          <h2 id="stack-title">Технологии</h2>
        </div>
        <ul class="tag-list">
          {project.stack.map((item) => <li><span class="tag">{item}</span></li>)}
        </ul>
      </section>

      {
        isLetterBox && project.links[0] && (
          <footer class="project-cta">
            <div>
              <p class="eyebrow">Open source</p>
              <h2>Исходный код на GitHub</h2>
            </div>
            <a
              class="btn btn-primary"
              href={project.links[0].href}
              target="_blank"
              rel="noopener noreferrer"
            >
              Открыть репозиторий <span aria-hidden="true">↗</span>
            </a>
          </footer>
        )
      }
    </div>
  </article>
</BaseLayout>

<style>
  .project-page {
    padding-block: clamp(2rem, 6vw, 4.5rem);
  }

  .back {
    display: inline-flex;
    margin-bottom: clamp(2.5rem, 6vw, 5rem);
    color: var(--text-muted);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
  }

  .back:hover {
    color: var(--accent);
  }

  .hero {
    max-width: 56rem;
    margin-bottom: clamp(4rem, 10vw, 7.5rem);
  }

  .eyebrow,
  .step {
    margin: 0;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0.5rem 0 1rem;
    font-size: clamp(3rem, 9vw, 6.5rem);
    line-height: 0.95;
    letter-spacing: -0.065em;
  }

  .summary {
    max-width: 46rem;
    margin: 0;
    color: var(--text-muted);
    font-size: clamp(1.15rem, 2.5vw, 1.5rem);
    line-height: 1.45;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.75rem;
  }

  .block {
    margin-bottom: clamp(4.5rem, 10vw, 8rem);
  }

  .section-title {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    margin-bottom: 1.5rem;
  }

  .section-title h2,
  .project-cta h2 {
    margin: 0;
    font-size: clamp(1.6rem, 4vw, 2.25rem);
    letter-spacing: -0.035em;
  }

  .screens :global(.viewport) {
    box-shadow: 0 24px 70px rgba(26, 34, 28, 0.1);
  }

  .features {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.8rem;
  }

  .feature {
    min-height: 13.5rem;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg-elevated);
    box-shadow: var(--shadow);
  }

  .feature-icon {
    display: grid;
    width: 2.4rem;
    height: 2.4rem;
    margin-bottom: 2.2rem;
    place-items: center;
    border-radius: 7px;
    background: var(--accent-soft);
    color: var(--accent);
    font-family: var(--font-mono);
  }

  .feature h3 {
    margin: 0 0 0.35rem;
    font-size: 1.05rem;
  }

  .feature p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .architecture-card {
    padding: clamp(1rem, 4vw, 2rem);
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 12px;
    background:
      linear-gradient(var(--accent-soft) 1px, transparent 1px),
      linear-gradient(90deg, var(--accent-soft) 1px, transparent 1px),
      var(--bg-elevated);
    background-size: 28px 28px;
  }

  .architecture-flow,
  .simple-arch {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.4rem, 1.5vw, 1rem);
  }

  .arch-node {
    min-width: 0;
    padding: 0.85rem 1rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-elevated);
    box-shadow: var(--shadow);
    text-align: center;
  }

  .arch-node span {
    display: block;
    margin-bottom: 0.15rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
  }

  .arch-node strong {
    font-size: 0.88rem;
    white-space: nowrap;
  }

  .arch-arrow {
    flex: 0 0 auto;
    color: var(--accent);
    font-family: var(--font-mono);
  }

  .architecture-targets {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .architecture-targets span {
    padding: 0.35rem 0.65rem;
    border: 1px dashed var(--border);
    border-radius: 5px;
    background: var(--bg);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .architecture-note {
    max-width: 40rem;
    margin: 1.5rem auto 0;
    color: var(--text-muted);
    text-align: center;
  }

  .simple-arch {
    justify-content: flex-start;
    margin-top: 1rem;
  }

  .stack .tag-list {
    gap: 0.6rem;
  }

  .stack .tag {
    padding: 0.45rem 0.7rem;
    border-radius: 6px;
    color: var(--text);
  }

  .project-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(1.5rem, 5vw, 2.5rem);
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg-elevated);
  }

  @media (max-width: 800px) {
    .features {
      grid-template-columns: repeat(2, 1fr);
    }

    .architecture-flow {
      display: grid;
      grid-template-columns: 1fr;
    }

    .arch-arrow {
      transform: rotate(90deg);
      text-align: center;
    }

    .project-cta {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 480px) {
    .features {
      grid-template-columns: 1fr;
    }

    .feature {
      min-height: auto;
    }

    .feature-icon {
      margin-bottom: 1.25rem;
    }

    .architecture-targets {
      flex-wrap: wrap;
    }
  }
</style>
