---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Chain from '../../components/Chain.astro';
import ArchFlow from '../../components/ArchFlow.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
---

<BaseLayout
  title={`${data.title} — ${site.name}`}
  description={data.intro}
>
  <article class="band">
    <div class="band__inner">
      <p class="note">
        <b>{data.year}</b>
        {data.kind}
      </p>

      <div>
        <p class="back"><a class="link" href="/">На главную</a></p>

        <h1 class="project-title" style={`view-transition-name: p-${project.id}`}>
          {data.title}
        </h1>
        <p class="lead project-intro">{data.intro}</p>
        <div class="project-chain"><Chain items={data.stack} /></div>
      </div>
    </div>
  </article>

  <section class="band" aria-labelledby="problem-title">
    <div class="band__inner">
      <p class="note"><b>Задача</b>зачем это вообще</p>
      <div>
        <h2 id="problem-title">Почему я за это взялся</h2>
        <p class="problem">{data.problem}</p>
      </div>
    </div>
  </section>

  {
    data.arch.length > 0 && (
      <section class="band" aria-labelledby="arch-title">
        <div class="band__inner">
          <p class="note">
            <b>Архитектура</b>
            {data.arch.length} слоя, сверху вниз
          </p>
          <div>
            <h2 id="arch-title">Как устроено</h2>
            <ArchFlow layers={data.arch} />
          </div>
        </div>
      </section>
    )
  }

  <section class="band" aria-labelledby="detail-title">
    <div class="band__inner">
      <p class="note"><b>Разбор</b>решения и грабли</p>
      <div class="prose">
        <h2 id="detail-title" class="visually-hidden">Разбор</h2>
        <Content />
      </div>
    </div>
  </section>

  {
    data.shots.length > 0 && (
      <section class="band" aria-labelledby="shots-title">
        <div class="band__inner">
          <p class="note">
            <b>Экраны</b>
            {data.shots.length === 1 ? 'один снимок' : `${data.shots.length} снимка`}
          </p>
          <div>
            <h2 id="shots-title">Как это выглядит</h2>
            <ul class="shots">
              {data.shots.map((shot) => (
                <li class="shot">
                  <Image
                    src={shot.src}
                    alt={shot.alt}
                    widths={[560, 900, 1280]}
                    sizes="(min-width: 900px) 800px, 92vw"
                    format="webp"
                    quality={70}
                    loading="lazy"
                    decoding="async"
                  />
                  <p class="note shot__caption">{shot.alt}</p>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )
  }

  <section class="band" aria-labelledby="links-title">
    <div class="band__inner">
      <p class="note"><b>Ссылки</b>посмотреть вживую</p>
      <div>
        <h2 id="links-title">Куда посмотреть</h2>
        <ul class="outlinks">
          {
            data.links.map((link) => (
              <li>
                <a class="link" href={link.href} rel="noopener">
                  {link.label}
                </a>
              </li>
            ))
          }
          <li><a class="link" href="/#contacts">Написать мне</a></li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .back {
    margin-bottom: 26px;
  }

  .project-title {
    font-size: clamp(2.25rem, 9.5vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.035em;
  }

  .project-intro {
    margin-top: 16px;
    color: var(--ink);
    font-size: clamp(1.0625rem, 3.8vw, 1.1875rem);
    max-width: 48ch;
  }

  .project-chain {
    margin-top: 22px;
  }

  .problem {
    margin-top: 18px;
    max-width: 60ch;
  }

  .prose {
    max-width: 62ch;
  }

  .prose :global(h2) {
    font-size: clamp(1.375rem, 4.6vw, 1.75rem);
    margin-bottom: 4px;
  }

  .prose :global(h2:not(:first-of-type)) {
    margin-top: 44px;
    padding-top: 26px;
    border-top: var(--hair);
  }

  .prose :global(h3) {
    margin-top: 30px;
    font-size: 1.0625rem;
    font-weight: 600;
  }

  .prose :global(p) {
    margin-top: 12px;
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--paper-2);
    border: var(--hair);
    padding: 0 4px;
  }

  .shots {
    display: grid;
    gap: 30px;
    margin-top: 24px;
  }

  .shot :global(img) {
    width: 100%;
    height: auto;
    border: var(--hair);
  }

  .shot__caption {
    margin-top: 8px;
    max-width: 60ch;
  }

  .outlinks {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 28px;
    margin-top: 20px;
  }
</style>
