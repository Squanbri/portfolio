---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ScreenshotSlider from '../../components/ScreenshotSlider.astro';
import { projects, getProject } from '../../data/content';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
  }));
}

const { slug } = Astro.params;
const project = getProject(slug!);

if (!project) {
  return Astro.redirect('/');
}
---

<BaseLayout title={`${project.title} — Евгений Маркитан`} description={project.summary}>
  <article class="project-page section">
    <div class="container">
      <p class="back">
        <a href="/#projects">← К портфолио</a>
      </p>

      <header class="header">
        <h1>{project.title}</h1>
        <p class="summary">{project.summary}</p>
        <ul class="tag-list">
          {
            project.stack.map((item) => (
              <li>
                <span class="tag">{item}</span>
              </li>
            ))
          }
        </ul>
        {
          project.links.length > 0 && (
            <p class="links">
              {project.links.map((link) => (
                <a class="btn btn-ghost" href={link.href} target="_blank" rel="noopener noreferrer">
                  {link.label}
                </a>
              ))}
            </p>
          )
        }
      </header>

      <section class="block">
        <h2>Описание</h2>
        <p>{project.description}</p>
      </section>

      <section class="block">
        <h2>Скриншоты</h2>
        <ScreenshotSlider images={project.screenshots} id={`project-${project.slug}`} />
      </section>

      <section class="block">
        <h2>Архитектура</h2>
        <p>{project.architectureNote}</p>
        <div class="arch" aria-hidden="true">
          <div class="node">Client</div>
          <div class="arrow">→</div>
          <div class="node">API</div>
          <div class="arrow">→</div>
          <div class="node">DB</div>
        </div>
      </section>

      <section class="block">
        <h2>Стек</h2>
        <ul class="tag-list">
          {
            project.stack.map((item) => (
              <li>
                <span class="tag">{item}</span>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  .back {
    margin: 0 0 1.25rem;
  }

  .back a {
    text-decoration: none;
    font-weight: 600;
  }

  .header {
    margin-bottom: 2.5rem;
  }

  h1 {
    margin: 0 0 0.6rem;
    font-size: clamp(1.85rem, 4vw, 2.5rem);
    letter-spacing: -0.03em;
  }

  .summary {
    margin: 0 0 1rem;
    color: var(--text-muted);
    font-size: 1.1rem;
    max-width: 42rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.1rem 0 0;
  }

  .block {
    margin-bottom: 2.25rem;
  }

  .block h2 {
    margin: 0 0 0.75rem;
    font-size: 1.25rem;
  }

  .block p {
    margin: 0;
    color: var(--text-muted);
    max-width: 42rem;
  }

  .arch {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .node {
    padding: 0.55rem 0.85rem;
    border: 1px dashed var(--border);
    border-radius: 6px;
    background: var(--bg-elevated);
    color: var(--text);
  }

  .arrow {
    color: var(--accent);
  }
</style>
