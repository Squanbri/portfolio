---
import type { CollectionEntry } from 'astro:content';
import Chain from './Chain.astro';

interface Props {
  items: CollectionEntry<'projects'>[];
}

const { items } = Astro.props;
---

<section class="band" aria-labelledby="projects-title">
  <div class="band__inner">
    <p class="note">
      <b>Проекты</b>
      открытый код у двух из трёх
    </p>

    <div class="projects">
      <span class="projects__pen" aria-hidden="true"></span>
      <h2 id="projects-title">Проекты</h2>

      <ul class="projects__list">
        {
          items.map((project) => (
            <li class="card">
              <p class="note card__note">
                <b>{project.data.year}</b>
                {project.data.kind}
              </p>
              <h3
                class="card__title"
                style={`view-transition-name: p-${project.id}`}
              >
                <a class="card__link" href={`/projects/${project.id}/`}>
                  {project.data.title}
                </a>
              </h3>
              <p class="card__text">{project.data.tagline}</p>
              <Chain items={project.data.stack} />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .projects {
    position: relative;
    padding-left: 18px;
  }

  @media (min-width: 900px) {
    .projects {
      padding-left: 26px;
    }
  }

  /* Выносная линия: прочерчивается по мере прокрутки, без JS */
  .projects__pen {
    position: absolute;
    left: 0;
    top: 4px;
    bottom: 4px;
    width: 1px;
    background: var(--plotter);
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .projects__pen {
        transform: scaleY(0);
        transform-origin: top center;
        /* Только лонгханды: шорткат animation сбрасывает duration в 0s,
           и по прогресс-таймлайну линия так и остаётся непрочерченной. */
        animation-name: pen-down;
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: cover 6% cover 84%;
      }
    }
  }

  @keyframes pen-down {
    to {
      transform: scaleY(1);
    }
  }

  .projects__list {
    margin-top: 26px;
  }

  .card {
    position: relative;
    display: grid;
    gap: 9px;
    border: var(--hair);
    padding: 18px 16px 20px;
  }

  .card + .card {
    margin-top: -1px;
  }

  @media (min-width: 900px) {
    .card {
      padding: 24px;
    }
  }

  .card__note {
    display: flex;
    flex-wrap: wrap;
    gap: 0 10px;
  }

  .card__note b {
    display: inline;
  }

  .card__title {
    font-size: clamp(1.25rem, 4.8vw, 1.625rem);
    font-weight: 600;
  }

  .card__link {
    text-decoration: none;
  }

  /* Ссылка растягивается на всю карточку, но фокус остаётся на тексте */
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card__text {
    max-width: 52ch;
  }

  .card:focus-within,
  .card:has(.card__link:active) {
    border-color: var(--plotter);
    z-index: 1;
  }

  @media (hover: hover) {
    .card:hover {
      border-color: var(--plotter);
      z-index: 1;
    }
  }
</style>
