---
interface Props {
  images: { src: string; alt: string }[];
  id: string;
}

const { images, id } = Astro.props;
---

<div
  class="slider"
  data-slider
  id={id}
  data-images={JSON.stringify(images)}
>
  <div class="viewport" data-viewport title="Листайте или нажмите, чтобы открыть">
    <ul class="track" data-track>
      {
        images.map((image, index) => (
          <li class="slide">
            <img
              src={image.src}
              alt={image.alt}
              loading={index === 0 ? 'eager' : 'lazy'}
              decoding="async"
              draggable="false"
              data-slide-image
              data-index={index}
            />
          </li>
        ))
      }
    </ul>
  </div>

  {
    images.length > 1 && (
      <div class="controls">
        <button type="button" class="ctrl" data-prev aria-label="Предыдущий скриншот">
          ←
        </button>
        <div class="dots" data-dots>
          {images.map((_, index) => (
            <button
              type="button"
              class:list={['dot', { active: index === 0 }]}
              data-dot={index}
              aria-label={`Скриншот ${index + 1}`}
            />
          ))}
        </div>
        <button type="button" class="ctrl" data-next aria-label="Следующий скриншот">
          →
        </button>
      </div>
    )
  }
</div>

<style>
  .slider {
    width: 100%;
  }

  .viewport {
    overflow: hidden;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--bg);
    touch-action: pan-y;
    cursor: grab;
    user-select: none;
  }

  .viewport.is-dragging {
    cursor: grabbing;
  }

  .track {
    display: flex;
    align-items: flex-start;
    margin: 0;
    padding: 0;
    list-style: none;
    transition: transform 0.3s ease;
    will-change: transform;
  }

  .track.is-dragging {
    transition: none;
  }

  .slide {
    flex: 0 0 100%;
    min-width: 100%;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg);
  }

  .slide img {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    max-height: none;
    object-fit: contain;
    object-position: center;
    pointer-events: none;
  }

  .controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.65rem;
  }

  .ctrl {
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text);
    border-radius: 6px;
    width: 2.25rem;
    height: 2.25rem;
    cursor: pointer;
    font: inherit;
  }

  .ctrl:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .dots {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    border: 0;
    padding: 0;
    background: var(--border);
    cursor: pointer;
  }

  .dot.active {
    background: var(--accent);
  }
</style>
