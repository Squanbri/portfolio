---
import { profile } from '../data/content';
---

<section id="education" class="section education">
  <div class="container">
    <p class="education-line">
      <span class="label mono">Образование</span>
      {profile.education}
    </p>
  </div>
</section>

<style>
  .education {
    padding-block: clamp(1.5rem, 4vw, 2.5rem);
  }

  .education-line {
    margin: 0;
    max-width: 42rem;
    color: var(--text-muted);
    display: grid;
    gap: 0.2rem;
  }

  .label {
    color: var(--text-muted);
    font-size: 0.78rem;
  }
</style>
