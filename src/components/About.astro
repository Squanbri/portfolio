---
import { profile, site } from '../data/content';
---

<section id="about" class="section">
  <div class="container">
    <div class="section-header">
      <h2>{profile.title}</h2>
      <p class="status mono">{site.seeking}</p>
    </div>

    <div class="pillars">
      {
        profile.pillars.map((pillar) => (
          <article class="pillar">
            <h3>{pillar.title}</h3>
            <p>{pillar.text}</p>
          </article>
        ))
      }
    </div>

    <p class="meta mono">{profile.meta}</p>
  </div>
</section>

<style>
  .status {
    margin: 0;
    color: var(--accent);
    font-size: 0.85rem;
  }

  .pillars {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem 1.75rem;
    margin-bottom: 1.5rem;
  }

  .pillar h3 {
    margin: 0 0 0.45rem;
    font-size: 1.05rem;
    font-weight: 650;
  }

  .pillar p {
    margin: 0;
    color: var(--text-muted);
    font-size: 1rem;
  }

  .meta {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  @media (max-width: 800px) {
    .pillars {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>
