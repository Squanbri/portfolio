---
/**
 * Soft animated atmosphere for the homepage.
 * Geometric objects drift across a fixed full-viewport layer.
 */
---

<div class="ambient" aria-hidden="true">
  <div class="ambient-wash"></div>
  <div class="ambient-glow ambient-glow-a"></div>
  <div class="ambient-glow ambient-glow-b"></div>
  <div class="ambient-glow ambient-glow-c"></div>

  <div class="field">
    <span class="shape shape-ring shape-a"></span>
    <span class="shape shape-ring shape-b"></span>
    <span class="shape shape-ring shape-c"></span>
    <span class="shape shape-ring-dashed shape-d"></span>
    <span class="shape shape-ring-dashed shape-e"></span>
    <span class="shape shape-square shape-f"></span>
    <span class="shape shape-square shape-g"></span>
    <span class="shape shape-diamond shape-h"></span>
    <span class="shape shape-diamond shape-i"></span>
    <span class="shape shape-line shape-j"></span>
    <span class="shape shape-line shape-k"></span>
    <span class="shape shape-line shape-l"></span>
    <span class="shape shape-dot shape-m"></span>
    <span class="shape shape-dot shape-n"></span>
    <span class="shape shape-dot shape-o"></span>
    <span class="shape shape-dot shape-p"></span>
    <span class="shape shape-dot shape-q"></span>
    <span class="shape shape-cross shape-r"></span>
    <span class="shape shape-cross shape-s"></span>
    <span class="shape shape-arc shape-t"></span>
    <span class="shape shape-arc shape-u"></span>
    <span class="shape shape-bracket shape-v"></span>
    <span class="shape shape-bracket shape-w"></span>
  </div>
</div>

<style>
  .ambient {
    position: fixed;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .ambient-wash {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 90% 60% at 8% 0%, color-mix(in srgb, var(--accent) 14%, transparent), transparent 62%),
      radial-gradient(ellipse 70% 50% at 92% 12%, color-mix(in srgb, var(--accent) 12%, transparent), transparent 65%),
      radial-gradient(ellipse 55% 40% at 70% 55%, color-mix(in srgb, var(--accent) 8%, transparent), transparent 70%),
      radial-gradient(ellipse 50% 35% at 20% 78%, color-mix(in srgb, var(--accent) 7%, transparent), transparent 72%);
  }

  .ambient-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(64px);
    opacity: 0.45;
  }

  .ambient-glow-a {
    width: min(48vw, 400px);
    height: min(48vw, 400px);
    top: -8%;
    left: -6%;
    background: color-mix(in srgb, var(--accent) 28%, transparent);
    animation: glow-drift 18s ease-in-out infinite alternate;
  }

  .ambient-glow-b {
    width: min(42vw, 340px);
    height: min(42vw, 340px);
    top: 8%;
    right: -8%;
    background: color-mix(in srgb, var(--accent) 22%, transparent);
    animation: glow-drift 22s ease-in-out infinite alternate-reverse;
  }

  .ambient-glow-c {
    width: min(50vw, 380px);
    height: min(36vw, 280px);
    bottom: 10%;
    left: 30%;
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    animation: glow-drift 20s ease-in-out infinite alternate;
  }

  .field {
    position: absolute;
    inset: 0;
    opacity: 0.42;
  }

  .shape {
    position: absolute;
    will-change: transform, opacity;
  }

  .shape-ring {
    border: 1.5px solid color-mix(in srgb, var(--accent) 55%, transparent);
    border-radius: 50%;
  }

  .shape-ring-dashed {
    border: 1.5px dashed color-mix(in srgb, var(--accent) 50%, transparent);
    border-radius: 50%;
  }

  .shape-square {
    border: 1.5px solid color-mix(in srgb, var(--accent) 52%, transparent);
  }

  .shape-diamond {
    border: 1.5px solid color-mix(in srgb, var(--accent) 50%, transparent);
  }

  .shape-line {
    height: 1.5px;
    background: color-mix(in srgb, var(--accent) 55%, transparent);
    transform-origin: center;
  }

  .shape-dot {
    border-radius: 50%;
    background: color-mix(in srgb, var(--accent) 80%, #fff);
    box-shadow: 0 0 8px color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .shape-cross {
    width: 18px;
    height: 18px;
  }

  .shape-cross::before,
  .shape-cross::after {
    content: '';
    position: absolute;
    background: color-mix(in srgb, var(--accent) 48%, transparent);
  }

  .shape-cross::before {
    left: 50%;
    top: 0;
    width: 1.5px;
    height: 100%;
    transform: translateX(-50%);
  }

  .shape-cross::after {
    top: 50%;
    left: 0;
    height: 1.5px;
    width: 100%;
    transform: translateY(-50%);
  }

  .shape-arc {
    border: 1.5px solid transparent;
    border-top-color: color-mix(in srgb, var(--accent) 50%, transparent);
    border-radius: 50%;
  }

  .shape-bracket {
    font-family: var(--font-mono);
    font-weight: 500;
    line-height: 1;
    color: color-mix(in srgb, var(--accent) 55%, transparent);
  }

  .shape-v::before {
    content: '{ }';
  }

  .shape-w::before {
    content: '</>';
  }

  .shape-a {
    width: 120px;
    height: 120px;
    top: 12%;
    left: 8%;
    animation: orbit-a 7s linear infinite;
  }

  .shape-b {
    width: 72px;
    height: 72px;
    top: 58%;
    left: 78%;
    animation: orbit-b 5.5s linear infinite;
  }

  .shape-c {
    width: 160px;
    height: 160px;
    top: 68%;
    left: 12%;
    animation: orbit-c 9s linear infinite;
  }

  .shape-d {
    width: 96px;
    height: 96px;
    top: 22%;
    left: 72%;
    animation: orbit-d 6s linear infinite;
  }

  .shape-e {
    width: 48px;
    height: 48px;
    top: 42%;
    left: 48%;
    animation: orbit-e 4.5s linear infinite;
  }

  .shape-f {
    width: 36px;
    height: 36px;
    top: 28%;
    left: 28%;
    animation: orbit-f 5s linear infinite;
  }

  .shape-g {
    width: 28px;
    height: 28px;
    top: 76%;
    left: 62%;
    animation: orbit-g 6.5s linear infinite;
  }

  .shape-h {
    width: 32px;
    height: 32px;
    top: 18%;
    left: 55%;
    animation: diamond-1 5.5s ease-in-out infinite;
  }

  .shape-i {
    width: 22px;
    height: 22px;
    top: 62%;
    left: 32%;
    animation: diamond-2 4s ease-in-out infinite;
  }

  .shape-j {
    width: 80px;
    top: 36%;
    left: 84%;
    animation: line-1 3.5s ease-in-out infinite;
  }

  .shape-k {
    width: 56px;
    top: 82%;
    left: 42%;
    animation: line-2 4.5s ease-in-out infinite;
  }

  .shape-l {
    width: 100px;
    top: 8%;
    left: 38%;
    animation: line-3 6s ease-in-out infinite;
  }

  .shape-m {
    width: 6px;
    height: 6px;
    top: 15%;
    left: 20%;
    animation: float-dot 3.5s ease-in-out infinite;
  }

  .shape-n {
    width: 4px;
    height: 4px;
    top: 48%;
    left: 90%;
    animation: float-dot 3s ease-in-out infinite 0.4s;
  }

  .shape-o {
    width: 5px;
    height: 5px;
    top: 70%;
    left: 55%;
    animation: float-dot 4s ease-in-out infinite 0.8s;
  }

  .shape-p {
    width: 4px;
    height: 4px;
    top: 34%;
    left: 6%;
    animation: float-dot 2.8s ease-in-out infinite 0.2s;
  }

  .shape-q {
    width: 7px;
    height: 7px;
    top: 88%;
    left: 88%;
    animation: float-dot 4.5s ease-in-out infinite 0.6s;
  }

  .shape-r {
    top: 50%;
    left: 18%;
    animation: orbit-r 5s linear infinite;
  }

  .shape-s {
    top: 14%;
    left: 88%;
    animation: orbit-s 4s linear infinite;
  }

  .shape-t {
    width: 64px;
    height: 64px;
    top: 40%;
    left: 65%;
    animation: orbit-t 5s linear infinite;
  }

  .shape-u {
    width: 88px;
    height: 88px;
    top: 78%;
    left: 24%;
    animation: orbit-u 6.5s linear infinite;
  }

  .shape-v {
    top: 55%;
    left: 4%;
    font-size: 1.35rem;
    animation: bracket-1 6s ease-in-out infinite;
  }

  .shape-w {
    top: 30%;
    left: 42%;
    font-size: 1.1rem;
    animation: bracket-2 4.5s ease-in-out infinite;
  }

  @keyframes glow-drift {
    from {
      transform: translate(0, 0) scale(1);
    }
    to {
      transform: translate(40px, 36px) scale(1.1);
    }
  }

  @keyframes orbit-a {
    0% {
      transform: translate(0, 0) rotate(0deg);
    }
    50% {
      transform: translate(110px, -90px) rotate(180deg);
    }
    100% {
      transform: translate(0, 0) rotate(360deg);
    }
  }

  @keyframes orbit-b {
    0% {
      transform: translate(0, 0) rotate(0deg);
    }
    50% {
      transform: translate(-120px, 80px) rotate(-180deg);
    }
    100% {
      transform: translate(0, 0) rotate(-360deg);
    }
  }

  @keyframes orbit-c {
    0% {
      transform: translate(0, 0) rotate(0deg);
      opacity: 0.55;
    }
    50% {
      transform: translate(130px, 95px) rotate(180deg);
      opacity: 1;
    }
    100% {
      transform: translate(0, 0) rotate(360deg);
      opacity: 0.55;
    }
  }

  @keyframes orbit-d {
    0% {
      transform: translate(0, 0) rotate(0deg);
    }
    50% {
      transform: translate(-95px, -110px) rotate(-180deg);
    }
    100% {
      transform: translate(0, 0) rotate(-360deg);
    }
  }

  @keyframes orbit-e {
    0% {
      transform: translate(0, 0) rotate(0deg) scale(1);
    }
    50% {
      transform: translate(80px, 120px) rotate(180deg) scale(1.3);
    }
    100% {
      transform: translate(0, 0) rotate(360deg) scale(1);
    }
  }

  @keyframes orbit-f {
    0% {
      transform: translate(0, 0) rotate(0deg);
    }
    50% {
      transform: translate(-100px, 70px) rotate(180deg);
    }
    100% {
      transform: translate(0, 0) rotate(360deg);
    }
  }

  @keyframes orbit-g {
    0% {
      transform: translate(0, 0) rotate(0deg);
    }
    50% {
      transform: translate(85px, -75px) rotate(-180deg);
    }
    100% {
      transform: translate(0, 0) rotate(-360deg);
    }
  }

  @keyframes orbit-r {
    0% {
      transform: translate(0, 0) rotate(0deg);
    }
    50% {
      transform: translate(70px, -95px) rotate(180deg);
    }
    100% {
      transform: translate(0, 0) rotate(360deg);
    }
  }

  @keyframes orbit-s {
    0% {
      transform: translate(0, 0) rotate(0deg);
    }
    50% {
      transform: translate(-75px, 80px) rotate(-180deg);
    }
    100% {
      transform: translate(0, 0) rotate(-360deg);
    }
  }

  @keyframes orbit-t {
    0% {
      transform: translate(0, 0) rotate(0deg);
    }
    50% {
      transform: translate(-105px, -70px) rotate(180deg);
    }
    100% {
      transform: translate(0, 0) rotate(360deg);
    }
  }

  @keyframes orbit-u {
    0% {
      transform: translate(0, 0) rotate(0deg);
    }
    50% {
      transform: translate(115px, -85px) rotate(-180deg);
    }
    100% {
      transform: translate(0, 0) rotate(-360deg);
    }
  }

  @keyframes diamond-1 {
    0%,
    100% {
      transform: translate(0, 0) rotate(45deg);
    }
    50% {
      transform: translate(90px, -100px) rotate(225deg);
    }
  }

  @keyframes diamond-2 {
    0%,
    100% {
      transform: translate(0, 0) rotate(45deg);
    }
    50% {
      transform: translate(-110px, 55px) rotate(-135deg);
    }
  }

  @keyframes line-1 {
    0%,
    100% {
      transform: translate(0, 0) rotate(-18deg);
      opacity: 0.45;
    }
    50% {
      transform: translate(-70px, 85px) rotate(40deg);
      opacity: 1;
    }
  }

  @keyframes line-2 {
    0%,
    100% {
      transform: translate(0, 0) rotate(32deg);
      opacity: 0.4;
    }
    50% {
      transform: translate(85px, -75px) rotate(-30deg);
      opacity: 0.95;
    }
  }

  @keyframes line-3 {
    0%,
    100% {
      transform: translate(0, 0) rotate(8deg) scaleX(1);
      opacity: 0.35;
    }
    50% {
      transform: translate(55px, 70px) rotate(-20deg) scaleX(1.45);
      opacity: 0.9;
    }
  }

  @keyframes float-dot {
    0%,
    100% {
      transform: translate(0, 0) scale(0.75);
      opacity: 0.25;
    }
    35% {
      transform: translate(45px, -100px) scale(1.35);
      opacity: 1;
    }
    70% {
      transform: translate(-30px, -170px) scale(1);
      opacity: 0.4;
    }
  }

  @keyframes bracket-1 {
    0%,
    100% {
      transform: translate(0, 0);
      opacity: 0.4;
    }
    50% {
      transform: translate(65px, -85px);
      opacity: 0.85;
    }
  }

  @keyframes bracket-2 {
    0%,
    100% {
      transform: translate(0, 0);
      opacity: 0.35;
    }
    50% {
      transform: translate(-75px, 60px);
      opacity: 0.8;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ambient-glow,
    .shape {
      animation: none !important;
    }
  }
</style>
