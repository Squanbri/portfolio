---
import { site } from '../data/site';

const fallbackPlanes = [0, 1, 2, 3, 4, 5];
---

<header class="band hero">
  <div class="hero__stage" data-hero-stage aria-hidden="true">
    <div class="hero__fallback">
      <div class="hero__stack">
        {
          fallbackPlanes.map((i) => (
            <div class="hero__plane" style={`--i: ${i}`}></div>
          ))
        }
      </div>
    </div>
    <div class="hero__canvas-host" data-hero-canvas-host></div>
  </div>

  <div class="band__inner hero__content">
    <p class="note hero__rail">
      <b>{site.city}</b>
      <span data-clock>UTC+3</span>
    </p>

    <div class="hero__body">
      <h1 class="hero__title">
        <span class="mask mask--a"><span class="hero__name">{site.name}</span></span>
        <span class="mask mask--b"><span class="hero__claim">{site.claim}</span></span>
      </h1>

      <svg
        class="hero__pen"
        viewBox="0 0 600 10"
        width="600"
        height="10"
        fill="none"
        aria-hidden="true"
        focusable="false"
      >
        <path
          d="M1 7 C 96 3.4, 168 7.6, 258 5 S 430 3.2, 520 6.2 599 4.4, 599 4.4"
          pathLength="1"
          stroke="var(--plotter)"
          stroke-width="2"
          stroke-linecap="round"
          vector-effect="non-scaling-stroke"
        ></path>
      </svg>

      <p class="mask mask--c">
        <span class="hero__lead">{site.subclaim}</span>
      </p>

      <div class="mask mask--d">
        <div class="hero__foot">
          <p class="note hero__exp">{site.experienceLabel} в коммерческой разработке</p>
          <p class="hero__links">
            <a class="link" href={`mailto:${site.email}`}>Написать на почту</a>
            <a class="link" href={site.telegram} rel="me noopener">Telegram</a>
          </p>
        </div>
      </div>
    </div>
  </div>
</header>

<script is:inline data-astro-rerun>
  (() => {
    const el = document.querySelector('[data-clock]');
    if (!el) return;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fmt = new Intl.DateTimeFormat('ru-RU', {
      timeZone: 'Europe/Moscow',
      hour: '2-digit',
      minute: '2-digit',
      ...(still ? {} : { second: '2-digit' }),
    });
    const tick = () => {
      el.textContent = fmt.format(new Date());
    };
    tick();
    clearInterval(window.__clock);
    if (!still) window.__clock = setInterval(tick, 1000);
  })();
</script>

<script>
  const stage = document.querySelector<HTMLElement>('[data-hero-stage]');
  if (
    stage &&
    !matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    const boot = () => {
      import('../scripts/hero-scene').then(({ mountHeroScene }) => {
        try {
          mountHeroScene(stage);
        } catch {
          /* фолбэк уже на экране */
        }
      }).catch(() => {});
    };

    if ('requestIdleCallback' in window) {
      requestIdleCallback(boot, { timeout: 1800 });
    } else {
      setTimeout(boot, 1);
    }
  }
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    min-height: min(100svh, 920px);
  }

  .hero__stage {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .hero__content {
    position: relative;
    z-index: 1;
  }

  .hero__canvas-host,
  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .hero__canvas {
    opacity: 0;
    transition: opacity 0.7s ease;
  }

  .hero__stage--live .hero__canvas {
    opacity: 1;
  }

  .hero__fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    perspective: 920px;
    perspective-origin: 50% 42%;
  }

  .hero__stack {
    position: relative;
    width: min(78vw, 640px);
    aspect-ratio: 4 / 3;
    transform-style: preserve-3d;
    transform: rotateX(56deg) rotateZ(-4deg);
  }

  .hero__plane {
    position: absolute;
    inset: 0;
    border: 1px solid color-mix(in srgb, var(--plotter) 42%, var(--rule));
    background-color: color-mix(in srgb, var(--paper-2) 72%, transparent);
    background-image:
      linear-gradient(to right, color-mix(in srgb, var(--graphite) 28%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, var(--graphite) 28%, transparent) 1px, transparent 1px);
    background-size: 10% 10%;
    transform: translate3d(0, calc(var(--i) * 10px), calc(var(--i) * -52px));
    opacity: calc(0.78 - var(--i) * 0.1);
  }

  .hero__plane:nth-child(1) {
    border-color: color-mix(in srgb, var(--plotter) 70%, var(--rule));
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__stack {
      animation: stack-drift 42s ease-in-out infinite;
    }
  }

  @keyframes stack-drift {
    0%,
    100% {
      transform: rotateX(56deg) rotateZ(-4deg) translateY(0);
    }
    50% {
      transform: rotateX(54deg) rotateZ(-2deg) translateY(6px);
    }
  }

  .hero__stage--live .hero__fallback {
    opacity: 0.35;
  }

  .hero__rail {
    display: flex;
    gap: 0 10px;
  }

  .hero__rail b {
    display: inline;
  }

  @media (min-width: 900px) {
    .hero__rail {
      display: block;
      padding-top: 0.7em;
    }

    .hero__rail b {
      display: block;
    }
  }

  /* Маска: строка выезжает из-под края, дескендеры не срезаются.
     Раскладку содержимого маска не трогает — иначе перебила бы
     собственные display у вложенных блоков. */
  .mask {
    display: block;
    overflow: hidden;
    padding-bottom: 0.14em;
    margin-bottom: -0.14em;
  }

  .mask > * {
    transform: translateY(110%);
    animation: rise 0.66s cubic-bezier(0.22, 0.68, 0.16, 1) forwards;
  }

  .mask--a > * {
    animation-delay: 0.04s;
  }
  .mask--b > * {
    animation-delay: 0.15s;
  }
  .mask--c > * {
    animation-delay: 0.3s;
  }
  .mask--d > * {
    animation-delay: 0.4s;
  }

  @keyframes rise {
    to {
      transform: translateY(0);
    }
  }

  .hero__title {
    display: grid;
    gap: 10px;
  }

  .hero__name {
    display: block;
    font-size: clamp(1.0625rem, 3.6vw, 1.25rem);
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--graphite);
  }

  .hero__claim {
    display: block;
    font-size: clamp(2.625rem, 12.5vw, 5.75rem);
    font-weight: 800;
    line-height: 0.94;
    letter-spacing: -0.038em;
  }

  .hero__pen {
    width: 100%;
    height: auto;
    margin-top: 14px;
  }

  .hero__pen path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: pen 0.62s cubic-bezier(0.35, 0, 0.2, 1) 0.52s forwards;
  }

  .hero__lead {
    display: block;
    font-size: clamp(1.0625rem, 4vw, 1.25rem);
    line-height: 1.45;
    margin-top: 22px;
    max-width: 44ch;
  }

  .hero__foot {
    display: grid;
    gap: 22px;
    margin-top: 36px;
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 26px;
  }

  .hero__links .link {
    font-size: 0.9375rem;
  }

  @keyframes pen {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mask > * {
      transform: none;
      animation: none;
    }

    .hero__pen path {
      stroke-dashoffset: 0;
      animation: none;
    }

    .hero__stack {
      animation: none;
    }
  }
</style>
