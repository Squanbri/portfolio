---
import { site, totalExperience } from '../data/site';

const experience = totalExperience();
---

<header class="band hero">
  <div class="band__inner">
    <p class="note hero__rail">
      <b>{site.city}</b>
      <span data-clock>UTC+3</span>
    </p>

    <div class="hero__body">
      <h1 class="hero__title">
        <span class="mask mask--a"><span class="hero__name">{site.name}</span></span>
        <span class="mask mask--b"><span class="hero__claim">{site.claim}</span></span>
      </h1>

      <svg
        class="hero__pen"
        viewBox="0 0 600 10"
        width="600"
        height="10"
        fill="none"
        aria-hidden="true"
        focusable="false"
      >
        <path
          d="M1 7 C 96 3.4, 168 7.6, 258 5 S 430 3.2, 520 6.2 599 4.4, 599 4.4"
          pathLength="1"
          stroke="var(--plotter)"
          stroke-width="2"
          stroke-linecap="round"
          vector-effect="non-scaling-stroke"
        ></path>
      </svg>

      <p class="mask mask--c">
        <span class="hero__lead">{site.subclaim}</span>
      </p>

      <div class="mask mask--d">
        <div class="hero__foot">
          <p class="note hero__exp">{experience} в коммерческой разработке</p>
          <p class="hero__links">
            <a class="link" href={`mailto:${site.email}`}>Написать на почту</a>
            <a class="link" href={site.telegram} rel="me noopener">Telegram</a>
          </p>
        </div>
      </div>
    </div>
  </div>
</header>

<script is:inline data-astro-rerun>
  (() => {
    const el = document.querySelector('[data-clock]');
    if (!el) return;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fmt = new Intl.DateTimeFormat('ru-RU', {
      timeZone: 'Europe/Moscow',
      hour: '2-digit',
      minute: '2-digit',
      ...(still ? {} : { second: '2-digit' }),
    });
    const tick = () => {
      el.textContent = fmt.format(new Date());
    };
    tick();
    clearInterval(window.__clock);
    if (!still) window.__clock = setInterval(tick, 1000);
  })();
</script>

<style>
  .hero__rail {
    display: flex;
    gap: 0 10px;
  }

  .hero__rail b {
    display: inline;
  }

  @media (min-width: 900px) {
    .hero__rail {
      display: block;
      padding-top: 0.7em;
    }

    .hero__rail b {
      display: block;
    }
  }

  /* Маска: строка выезжает из-под края, дескендеры не срезаются.
     Раскладку содержимого маска не трогает — иначе перебила бы
     собственные display у вложенных блоков. */
  .mask {
    display: block;
    overflow: hidden;
    padding-bottom: 0.14em;
    margin-bottom: -0.14em;
  }

  .mask > * {
    transform: translateY(110%);
    animation: rise 0.66s cubic-bezier(0.22, 0.68, 0.16, 1) forwards;
  }

  .mask--a > * {
    animation-delay: 0.04s;
  }
  .mask--b > * {
    animation-delay: 0.15s;
  }
  .mask--c > * {
    animation-delay: 0.3s;
  }
  .mask--d > * {
    animation-delay: 0.4s;
  }

  @keyframes rise {
    to {
      transform: translateY(0);
    }
  }

  .hero__title {
    display: grid;
    gap: 10px;
  }

  .hero__name {
    display: block;
    font-size: clamp(1.0625rem, 3.6vw, 1.25rem);
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--graphite);
  }

  .hero__claim {
    display: block;
    font-size: clamp(2.625rem, 12.5vw, 5.75rem);
    font-weight: 800;
    line-height: 0.94;
    letter-spacing: -0.038em;
  }

  .hero__pen {
    width: 100%;
    height: auto;
    margin-top: 14px;
  }

  .hero__pen path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: pen 0.62s cubic-bezier(0.35, 0, 0.2, 1) 0.52s forwards;
  }

  .hero__lead {
    display: block;
    font-size: clamp(1.0625rem, 4vw, 1.25rem);
    line-height: 1.45;
    margin-top: 22px;
    max-width: 44ch;
  }

  .hero__foot {
    display: grid;
    gap: 22px;
    margin-top: 36px;
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 26px;
  }

  .hero__links .link {
    font-size: 0.9375rem;
  }

  @keyframes pen {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mask > * {
      transform: none;
      animation: none;
    }

    .hero__pen path {
      stroke-dashoffset: 0;
      animation: none;
    }
  }
</style>
