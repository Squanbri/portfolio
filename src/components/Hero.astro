---
import { site } from '../data/site';
---

<header class="band hero">
  <div class="hero-texture" aria-hidden="true"></div>

  <div class="band__inner hero__content">
    <p class="note hero__rail">
      <b>{site.city}</b>
      <span data-clock>UTC+3</span>
    </p>

    <div class="hero__body">
      <h1 class="hero__title">
        <span class="hero__name">{site.name}</span>
        <span class="hero__claim">{site.claim}</span>
      </h1>

      <span class="hero__rule" aria-hidden="true"></span>

      <p class="hero__lead">{site.subclaim}</p>

      <p class="hero__links">
        <a class="link" href={`mailto:${site.email}`}>Написать на почту</a>
        <a class="link" href={site.telegram} rel="me noopener">Telegram</a>
      </p>
    </div>
  </div>
</header>

<script is:inline data-astro-rerun>
  (() => {
    const el = document.querySelector('[data-clock]');
    if (!el) return;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fmt = new Intl.DateTimeFormat('ru-RU', {
      timeZone: 'Europe/Moscow',
      hour: '2-digit',
      minute: '2-digit',
      ...(still ? {} : { second: '2-digit' }),
    });
    const tick = () => {
      el.textContent = fmt.format(new Date());
    };
    tick();
    clearInterval(window.__clock);
    if (!still) window.__clock = setInterval(tick, 1000);
  })();
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
  }

  .hero-texture {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, var(--texture-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--texture-line) 1px, transparent 1px);
    background-size: 34px 34px;
    -webkit-mask-image: radial-gradient(120% 90% at 15% 0%, #000 0%, transparent 78%);
    mask-image: radial-gradient(120% 90% at 15% 0%, #000 0%, transparent 78%);
  }

  .hero__content {
    position: relative;
  }

  .hero__rail {
    display: flex;
    gap: 0 10px;
  }

  .hero__rail b {
    display: inline;
  }

  @media (min-width: 900px) {
    .hero__rail {
      display: block;
      padding-top: 0.7em;
    }

    .hero__rail b {
      display: block;
    }
  }

  .hero__title {
    display: grid;
    gap: 8px;
  }

  .hero__name {
    display: block;
    font-size: clamp(1.0625rem, 3.6vw, 1.25rem);
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--graphite);
  }

  .hero__claim {
    display: block;
    font-size: clamp(2.5rem, 11.5vw, 5.5rem);
    font-weight: 800;
    line-height: 1.03;
    letter-spacing: -0.025em;
  }

  .hero__rule {
    display: block;
    width: 44px;
    height: 2px;
    margin-top: 16px;
    background: var(--plotter);
  }

  .hero__lead {
    margin-top: 28px;
    max-width: 44ch;
    font-size: clamp(1.0625rem, 4vw, 1.25rem);
    line-height: 1.45;
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 26px;
    margin-top: 28px;
  }

  .hero__links .link {
    font-size: 0.9375rem;
  }
</style>
