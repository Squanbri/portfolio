---
import { site } from '../data/content';
---

<section class="hero section">
  <div class="container hero-grid">
    <div class="hero-copy">
      <div class="identity">
        <figure class="portrait">
          <img
            src={site.photo}
            alt={`Фото: ${site.name}`}
            width="480"
            height="480"
            loading="eager"
            decoding="async"
          />
        </figure>
        <div class="identity-text">
          <p class="eyebrow mono">{site.role}</p>
          <h1>{site.name}</h1>
        </div>
      </div>

      <p class="lead">
        React и TypeScript · веб и мобильные приложения · 5+ лет опыта.
        Открыт к предложениям: удалённо или гибрид, Тверь / Москва / Россия.
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="#projects">Смотреть проекты</a>
        <a class="btn btn-ghost" href={`mailto:${site.email}`}>Написать</a>
      </div>
    </div>

    <div class="hero-visual">
      <div class="terminal" aria-hidden="true">
        <div class="terminal-bar">
          <span class="dot red"></span>
          <span class="dot yellow"></span>
          <span class="dot green"></span>
          <span class="terminal-title mono">zsh — portfolio</span>
        </div>
        <div class="terminal-body mono" data-terminal-log></div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-top: clamp(2rem, 5vw, 3.25rem);
    padding-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr minmax(280px, 0.95fr);
    gap: clamp(1.75rem, 4vw, 3.25rem);
    align-items: center;
  }

  .identity {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    margin-bottom: 1.15rem;
  }

  .portrait {
    margin: 0;
    flex: 0 0 auto;
    width: clamp(84px, 12vw, 112px);
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid color-mix(in srgb, var(--accent) 35%, var(--border));
    background: var(--bg-elevated);
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--accent) 10%, transparent);
  }

  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .identity-text {
    min-width: 0;
  }

  .eyebrow {
    margin: 0 0 0.35rem;
    color: var(--accent);
    font-size: 0.85rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(1.85rem, 4.4vw, 2.75rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
    font-weight: 700;
  }

  .lead {
    margin: 0 0 1.5rem;
    color: var(--text-muted);
    max-width: 34rem;
    font-size: 1.08rem;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .hero-visual {
    min-width: 0;
  }

  .terminal {
    width: 100%;
    background: var(--terminal-bg);
    border-radius: 12px;
    overflow: hidden;
    box-shadow:
      0 18px 40px color-mix(in srgb, #000 18%, transparent),
      0 0 0 1px color-mix(in srgb, var(--border) 50%, #000);
    transform: rotate(-0.6deg);
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.65rem 0.85rem;
    background: color-mix(in srgb, var(--terminal-bg) 80%, #000);
  }

  .dot {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
  }

  .dot.red {
    background: #ff5f56;
  }

  .dot.yellow {
    background: #ffbd2e;
  }

  .dot.green {
    background: #27c93f;
  }

  .terminal-title {
    margin-left: auto;
    color: var(--terminal-muted);
    font-size: 0.75rem;
  }

  .terminal-body {
    padding: 0.9rem 1rem 1.1rem;
    color: var(--terminal-text);
    height: 18rem;
    overflow: hidden;
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .terminal-body :global(.line) {
    margin: 0 0 0.28rem;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .terminal-body :global(.prompt) {
    color: var(--cursor);
    margin-right: 0.4rem;
  }

  .terminal-body :global(.cmd) {
    color: #e8f5ec;
  }

  .terminal-body :global(.ok) {
    color: #5ecf8a;
  }

  .terminal-body :global(.warn) {
    color: #e6c35c;
  }

  .terminal-body :global(.err) {
    color: #ff7b72;
  }

  .terminal-body :global(.muted) {
    color: var(--terminal-muted);
  }

  .terminal-body :global(.dim) {
    color: color-mix(in srgb, var(--terminal-muted) 75%, #fff);
  }

  .terminal-body :global(.cursor) {
    display: inline-block;
    width: 0.55ch;
    height: 1.05em;
    margin-left: 1px;
    vertical-align: text-bottom;
    background: var(--cursor);
    animation: blink 1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .terminal {
      transform: none;
    }

    .terminal-body {
      height: 15rem;
    }
  }

  @media (max-width: 520px) {
    .identity {
      gap: 0.85rem;
    }

    .portrait {
      width: 76px;
      box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 10%, transparent);
    }

    h1 {
      font-size: clamp(1.65rem, 8vw, 2rem);
    }
  }
</style>
