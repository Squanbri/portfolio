---
import { jobs, totalExperience } from '../data/site';
---

<section class="band" aria-labelledby="experience-title">
  <div class="band__inner">
    <p class="note">
      <b>Опыт</b>
      {totalExperience()} в коммерческой разработке
    </p>

    <div>
      <h2 id="experience-title">Где работал</h2>

      <ul class="jobs">
        {
          jobs.map((job) => (
            <li class="job">
              <div class="job__head">
                <h3>{job.company}</h3>
                <p class="note job__meta">
                  <b>{job.period}</b>
                  {job.role}
                </p>
              </div>
              <p class="job__result">{job.result}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .jobs {
    margin-top: 26px;
  }

  .job {
    display: grid;
    gap: 10px;
    padding: 22px 0;
    border-top: var(--hair);
  }

  .job:last-child {
    padding-bottom: 0;
  }

  .job__head {
    display: grid;
    gap: 4px;
  }

  .job__result {
    max-width: 58ch;
  }

  @media (min-width: 640px) {
    .job__head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 16px;
    }

    .job__meta {
      text-align: right;
      flex: none;
    }
  }
</style>
