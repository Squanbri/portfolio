---
interface Props {
  title?: string;
  variant?: 'letter-box' | 'screen-translator';
}

const { title = 'Схема архитектуры', variant = 'letter-box' } = Astro.props;
---

<figure class="diagram">
  {
    variant === 'letter-box' ? (
      <svg viewBox="0 0 960 300" role="img" aria-label={title}>
        <defs>
          <marker
            id="arrow"
            viewBox="0 0 10 10"
            refX="9"
            refY="5"
            markerWidth="7"
            markerHeight="7"
            orient="auto-start-reverse"
          >
            <path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor" />
          </marker>
        </defs>

        <g class="edges" fill="none" stroke="currentColor" stroke-width="1.5" marker-end="url(#arrow)">
          <path d="M150 70 H198" />
          <path d="M330 70 H378" />
          <path d="M330 110 V148" />
          <path d="M530 70 H578" />
          <path d="M730 70 H778" />
          <path d="M670 110 V148" />
        </g>

        <g class="node" transform="translate(40 40)">
          <rect width="110" height="60" rx="8" />
          <text x="55" y="35" text-anchor="middle">Electron</text>
        </g>

        <g class="node" transform="translate(210 40)">
          <rect width="120" height="60" rx="8" />
          <text x="60" y="35" text-anchor="middle">NestJS API</text>
        </g>

        <g class="node" transform="translate(390 40)">
          <rect width="140" height="60" rx="8" />
          <text x="70" y="35" text-anchor="middle">Redis + BullMQ</text>
        </g>

        <g class="node" transform="translate(590 40)">
          <rect width="140" height="60" rx="8" />
          <text x="70" y="28" text-anchor="middle">Sync / AI</text>
          <text x="70" y="46" text-anchor="middle">Worker</text>
        </g>

        <g class="node" transform="translate(790 40)">
          <rect width="130" height="60" rx="8" />
          <text x="65" y="35" text-anchor="middle">IMAP / SMTP</text>
        </g>

        <g class="node" transform="translate(210 160)">
          <rect width="120" height="60" rx="8" />
          <text x="60" y="35" text-anchor="middle">PostgreSQL</text>
        </g>

        <g class="node" transform="translate(595 160)">
          <rect width="130" height="60" rx="8" />
          <text x="65" y="35" text-anchor="middle">Ollama</text>
        </g>
      </svg>
    ) : (
      <svg viewBox="0 0 980 300" role="img" aria-label={title}>
        <defs>
          <marker
            id="arrow-st"
            viewBox="0 0 10 10"
            refX="9"
            refY="5"
            markerWidth="7"
            markerHeight="7"
            orient="auto-start-reverse"
          >
            <path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor" />
          </marker>
        </defs>

        <g class="edges" fill="none" stroke="currentColor" stroke-width="1.5" marker-end="url(#arrow-st)">
          <!-- Electron -> Overlay -->
          <path d="M188 70 H278" />
          <!-- Overlay -> FastAPI -->
          <path d="M398 70 H488" />
          <!-- FastAPI right edge (608) -> node centers -->
          <path d="M608 55 C650 55, 650 40, 692 40" />
          <path d="M608 70 C650 70, 650 100, 692 100" />
          <path d="M608 85 C650 85, 650 170, 692 170" />
          <!-- Overlay -> Electron (IPC) -->
          <path d="M338 100 V190 H104 V100" />
        </g>

        <g class="node" transform="translate(30 40)">
          <rect width="158" height="60" rx="8" />
          <text x="79" y="27" text-anchor="middle">Electron tray</text>
          <text x="79" y="45" text-anchor="middle">/ hotkey</text>
        </g>

        <g class="node" transform="translate(278 40)">
          <rect width="120" height="60" rx="8" />
          <text x="60" y="35" text-anchor="middle">Overlay</text>
        </g>

        <g class="node" transform="translate(488 40)">
          <rect width="120" height="60" rx="8" />
          <text x="60" y="35" text-anchor="middle">FastAPI</text>
        </g>

        <!-- Tesseract: y=10..70, center=40 -->
        <g class="node" transform="translate(692 10)">
          <rect width="160" height="60" rx="8" />
          <text x="80" y="35" text-anchor="middle">Tesseract OCR</text>
        </g>

        <!-- Argos: y=70..130, center=100 -->
        <g class="node" transform="translate(692 70)">
          <rect width="160" height="60" rx="8" />
          <text x="80" y="35" text-anchor="middle">Argos Translate</text>
        </g>

        <!-- SQLite: y=140..190, center≈170 -->
        <g class="node cylinder" transform="translate(692 140)">
          <path d="M0 12 V48" />
          <path d="M160 12 V48" />
          <rect x="0" y="12" width="160" height="36" />
          <ellipse cx="80" cy="12" rx="80" ry="12" />
          <ellipse cx="80" cy="48" rx="80" ry="12" />
          <text x="80" y="38" text-anchor="middle">SQLite words</text>
        </g>

        <!-- Labels last so boxes never cover them -->
        <g class="edge-labels" fill="currentColor">
          <text x="233" y="58" text-anchor="middle">screenshot</text>
          <text x="443" y="58" text-anchor="middle">image</text>
          <text x="221" y="208" text-anchor="middle">IPC</text>
        </g>
      </svg>
    )
  }

  <figcaption class="sr-only">
    {
      variant === 'letter-box'
        ? 'Electron подключается к NestJS API. API пишет в Redis + BullMQ и PostgreSQL. Очередь запускает Sync / AI Worker, который работает с IMAP / SMTP и Ollama.'
        : 'Electron tray по хоткею делает screenshot и открывает Overlay. Overlay отправляет image в FastAPI, который использует Tesseract OCR, Argos Translate и SQLite dictionary. Overlay общается с Electron через IPC.'
    }
  </figcaption>
</figure>

<style>
  .diagram {
    margin: 0;
    padding: 1rem 0.5rem;
    overflow-x: auto;
  }

  svg {
    display: block;
    width: 100%;
    min-width: 720px;
    height: auto;
    color: var(--accent);
  }

  .node rect,
  .node ellipse {
    fill: var(--bg-elevated);
    stroke: var(--border);
    stroke-width: 1.5;
  }

  .node.cylinder path {
    fill: none;
    stroke: var(--border);
    stroke-width: 1.5;
  }

  .node.cylinder rect {
    stroke: none;
  }

  .node text {
    fill: var(--text);
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .edge-labels text {
    font-family: var(--font-mono);
    font-size: 11px;
    opacity: 0.9;
  }

  .edges {
    opacity: 0.85;
  }
</style>
